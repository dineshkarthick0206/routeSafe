# Copy this file to ".env" and fill in your real keys.
# Never commit the real ".env" file to git.

OPENWEATHER_API_KEY=your_openweathermap_key_here
OPENAQ_API_KEY=your_openaq_key_here
ORS_API_KEY=your_openrouteservice_key_here

# Optional
# Different crime-rate CSV (default: app/data/TN_district_crime_rates_2016_2023.csv)
# CRIME_CSV_PATH=
# 0..1 weight of the synthetic street-level layer in crime scoring (default 0.4).
# 0 = score crime from the CSV district rates only.
# STREET_LAYER_WEIGHT=0.4
